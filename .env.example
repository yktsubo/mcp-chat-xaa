# ローカル開発用。.env.local にコピーして値を入れる（Vercel では同じ名前で Environment Variables に設定する）

# --- アプリ ---
NEXTAUTH_URL=http://localhost:3000
# ログインのセッションの暗号鍵。openssl rand -base64 32
NEXTAUTH_SECRET=

# --- アプリへのログイン（Okta の OIDC アプリ。AI エージェントに結び付いたもの） ---
# 例: https://your-org.okta.com
OKTA_ISSUER=
OKTA_CLIENT_ID=
# クライアントシークレットか、AI エージェントの秘密鍵（JWK を 1 行の JSON で。設定すると private_key_jwt を使う）のどちらか
OKTA_CLIENT_SECRET=
OKTA_AI_AGENT_PRIVATE_KEY=
# XAA の交換を行う AI エージェントの ID（省略時は OKTA_CLIENT_ID）
OKTA_AI_AGENT_ID=

# --- MCP サーバー（JSON 配列。書き方は README） ---
# 例: [{"name":"gateway","label":"Okta Agent Gateway","url":"https://your-org.gateway.okta.com/mcp/servers/xxx","description":"Jira と Confluence","auth":"xaa","scope":"gateway:connect"},{"name":"notion","label":"Notion","url":"https://mcp.notion.com/mcp","description":"Notion のページとデータベース"}]
MCP_SERVERS=

# --- MCP のトークンの保存先（Upstash Redis） ---
# Vercel で Upstash Redis をつなぐと自動で入る。ローカルでは `vercel env pull .env.local` で取得する。
# 未設定ならローカル開発に限りメモリに保存する（Vercel 上では未設定だとエラー）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- チャットの回数制限（ユーザーごと、1 分あたり。省略時 10。Redis が無いローカル開発では制限しない） ---
CHAT_RATE_LIMIT_PER_MINUTE=

# --- システムプロンプト（省略可） ---
SYSTEM_PROMPT=

# --- LLM: AZURE_OPENAI_DEPLOYMENT を設定すると Azure OpenAI、未設定なら Claude ---
ANTHROPIC_API_KEY=
# 省略時 claude-haiku-5-5（例: claude-sonnet-5-5, claude-opus-5-5）
ANTHROPIC_MODEL=
# ワークスペースに紐づかない組織キーの場合だけ
ANTHROPIC_WORKSPACE_ID=
AZURE_API_KEY=
# https://<これ>.openai.azure.com
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
